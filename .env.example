# Discloner configuration (all values optional)

# HTTP port (1-65535). Defaults to 3000.
PORT=3000

# Bind address. Defaults to 0.0.0.0 (reachable from your network).
# Set to 127.0.0.1 to accept local connections only.
HOST=0.0.0.0

# Comma-separated Socket.IO origin allowlist.
# Leave UNSET for same-origin only, which is what the bundled dashboard needs.
# Only set "*" if you really intend to accept cross-origin browser clients.
# ALLOWED_ORIGINS=https://cloner.example.com
