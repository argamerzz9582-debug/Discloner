# =============================================================================
# DISCLONER STUDIO — environment reference
#
# Copy to `.env` (git-ignored) or export these before `npm start`.
# Everything here is optional: the app runs with sane defaults.
# =============================================================================

# ---- Network ---------------------------------------------------------------
PORT=3000

# Bind address.
#   127.0.0.1  → this machine only (RECOMMENDED: the UI accepts a credential)
#   0.0.0.0    → every interface (only behind an authenticating reverse proxy)
HOST=127.0.0.1

# Comma-separated allowlist of browser origins for CORS + Socket.IO.
# Leave empty for same-origin only. Never use "*" in production.
# ALLOWED_ORIGINS=https://discloner.example.com

# ---- Concurrency & queue ---------------------------------------------------
# How many jobs may run at once (1–5).
MAX_CONCURRENT_JOBS=2
# How many jobs may wait (1–200).
MAX_QUEUED_JOBS=20
# Simultaneous continuous-mirror sessions (1–5). Each holds a gateway connection.
MAX_MIRROR_SESSIONS=1

# ---- Resumable jobs --------------------------------------------------------
PERSIST_JOBS=true
JOB_STATE_DIR=.discloner/state
# Checkpoints older than this are pruned on boot (0–90 days).
STATE_RETENTION_DAYS=7

# ---- Observability ---------------------------------------------------------
# debug | info | warn | error | silent
LOG_LEVEL=info
# pretty | json   (json is the default when NODE_ENV=production)
LOG_FORMAT=pretty

# ---- Feature flags ---------------------------------------------------------
FEATURE_CONTINUOUS_MIRROR=true
FEATURE_MULTI_JOB=true
FEATURE_RESUME=true
FEATURE_TELEMETRY=false

# ---- Opt-in telemetry ------------------------------------------------------
# Nothing leaves the process unless FEATURE_TELEMETRY=true AND both values below
# are set. Events are anonymous counters only — never tokens, IDs or content.
TELEMETRY_OPT_IN=false
# TELEMETRY_ENDPOINT=https://telemetry.example.com/v1/events

# ---- Shutdown --------------------------------------------------------------
# Grace period for tearing down Discord connections (500–60000 ms).
SHUTDOWN_GRACE_MS=8000

# ---- Runtime ---------------------------------------------------------------
NODE_ENV=development
