{
  "name": "discord-server-cloner",
  "version": "3.0.0",
  "description": "Discloner Studio \u2014 precision Discord server migration, continuous mirroring and resumable jobs",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "build": "npm run lint",
    "lint": "node scripts/check-syntax.mjs",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "docker:build": "docker build -t discloner:latest .",
    "docker:run": "docker compose up --build"
  },
  "dependencies": {
    "discord.js-selfbot-v13": "3.7.1",
    "express": "^4.19.2",
    "socket.io": "^4.7.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "jsdom": "^30.1.3"
  }
}
